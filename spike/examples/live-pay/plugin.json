{
  "id": "example.live-pay",
  "name": "实时工资",
  "author": "岛仔",
  "version": "1.0.0",
  "api": 1,
  "runtime": "js",
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "status",
  "capabilities": ["status.page", "settings", "timer"],
  "refreshSeconds": 60,
  "dataVersion": 1,
  "permissions": {},
  "settings": [
    {"key":"salary","label":"月薪（元）","type":"text","default":"10000"},
    {"key":"start","label":"上班时间","type":"text","default":"09:00"},
    {"key":"end","label":"下班时间","type":"text","default":"18:00"},
    {"key":"days","label":"工作日（周一为 1）","type":"text","default":"1,2,3,4,5"}
  ],
  "statusLayout": {
    "components": [{"type":"state"},{"type":"summary"},{"type":"counter"},{"type":"countdown"}],
    "style": {"density":"compact","emphasis":"strong"}
  }
}
