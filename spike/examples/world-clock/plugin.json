{
  "id": "example.world-clock",
  "name": "世界时钟",
  "author": "岛仔",
  "version": "1.1.0",
  "api": 1,
  "runtime": "js",
  "entry": "main.js",
  "cover": "cover.png",
  "owner": "status",
  "capabilities": [
    "status.page",
    "settings",
    "timer"
  ],
  "refreshSeconds": 3600,
  "dataVersion": 1,
  "permissions": {},
  "settings": [
    {
      "key": "cities",
      "label": "城市",
      "type": "list",
      "maxItems": 4,
      "default": "[{\"name\": \"北京\", \"zone\": \"Asia/Shanghai\"}, {\"name\": \"东京\", \"zone\": \"Asia/Tokyo\"}, {\"name\": \"伦敦\", \"zone\": \"Europe/London\"}, {\"name\": \"纽约\", \"zone\": \"America/New_York\"}]",
      "item": [
        {
          "key": "name",
          "label": "显示名称",
          "type": "text",
          "default": "北京"
        },
        {
          "key": "zone",
          "label": "时区",
          "type": "choice",
          "default": "Asia/Shanghai",
          "choices": [
            {
              "value": "Asia/Shanghai",
              "label": "北京"
            },
            {
              "value": "Asia/Tokyo",
              "label": "东京"
            },
            {
              "value": "Europe/London",
              "label": "伦敦"
            },
            {
              "value": "America/New_York",
              "label": "纽约"
            },
            {
              "value": "America/Los_Angeles",
              "label": "洛杉矶"
            },
            {
              "value": "Australia/Sydney",
              "label": "悉尼"
            }
          ]
        }
      ]
    }
  ],
  "statusLayout": {
    "components": [
      {
        "type": "state"
      },
      {
        "type": "clock"
      },
      {
        "type": "clock"
      },
      {
        "type": "clock"
      },
      {
        "type": "clock"
      }
    ],
    "style": {
      "icon": "clock"
    }
  },
  "timezones": true
}
