{
  "id": "cayww.liquid-glass",
  "name": "液态玻璃",
  "author": "轻九九九（@cayww）",
  "version": "1.0.1",
  "api": 1,
  "runtime": "material",
  "entry": "material.wgsl",
  "owner": "appearance",
  "capabilities": ["appearance.material", "settings"],
  "dataVersion": 1,
  "permissions": {"screen.backdrop": true},
  "material": {
    "controls": true,
    "spring": {"stiffness": 1.0, "damping": 0.5},
    "shadow": 1.0,
    "foreground": "glass"
  },
  "settings": [
    {"key": "refract", "label": "折射", "type": "number", "min": 0, "max": 120, "step": 1, "default": "48"},
    {"key": "chroma", "label": "色散", "type": "number", "min": 0, "max": 30, "step": 1, "default": "8"},
    {"key": "blur", "label": "内部模糊", "type": "number", "min": 0, "max": 4, "step": 0.1, "default": "1.5"},
    {"key": "band", "label": "折射带宽", "type": "number", "min": 10, "max": 140, "step": 1, "default": "87"},
    {"key": "edge-width", "label": "白边宽度", "type": "number", "min": 0, "max": 4, "step": 0.1, "default": "1.5"},
    {"key": "edge-opacity", "label": "白边不透明度", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": "0.9"},
    {"key": "morph", "label": "形变", "type": "number", "min": 0, "max": 3, "step": 0.01, "default": "1.0"}
  ]
}
