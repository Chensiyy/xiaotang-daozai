{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "岛仔 SDK v1 插件清单（评审稿）",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "api": {
      "const": 1,
      "description": "插件要求的接口主版本。高于宿主支持版本时，安装提示需要更新岛仔。"
    },
    "runtime": {
      "enum": [
        "js",
        "wasm",
        "assets",
        "material"
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
    },
    "cover": {
      "const": "cover.png",
      "description": "包根目录的 PNG 封面，最大 256 KiB，宽高不超过 1920×1080，建议 16:9。"
    },
    "owner": {
      "enum": [
        "self",
        "general",
        "appearance",
        "pages",
        "tasks",
        "focus",
        "calendar",
        "music",
        "quota",
        "status",
        "notifications",
        "weather",
        "wireless"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "settings",
          "card",
          "calendar.marker",
          "module",
          "calendar.source",
          "lyrics.source",
          "quota.source",
          "status.page",
          "appearance.skin",
          "appearance.material",
          "navigation.shortcuts",
          "wireless.receivers",
          "storage",
          "timer",
          "action",
          "event",
          "notice",
          "network",
          "file.read",
          "appearance.pet",
          "appearance.icon"
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "refreshSeconds": {"type":"integer","minimum":60,"maximum":86400,"default":60},
    "network": {
      "type": "object",
      "description": "实验。宿主动作允许打开的 HTTPS 域名。",
      "properties": {
        "hosts": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"type": "string", "format": "hostname", "maxLength": 253}
        }
      },
      "required": ["hosts"],
      "additionalProperties": false
    },
    "statusLayout": {
      "type": "object",
      "description": "状态详情页的组件顺序与样式。缺省时使用默认模板。",
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {"type": {"enum": ["state", "summary", "alert", "updated_at", "actions", "fields", "list", "chart", "text", "badge", "counter", "clock", "countdown"]}},
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {"const": "progress"},
                  "variant": {"enum": ["ring", "bar"], "default": "ring"}
                },
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {"const": "metrics"},
                  "columns": {"enum": [1, 2], "default": 2}
                },
                "required": ["type"],
                "additionalProperties": false
              }
            ]
          },
          "allOf": [
            {"contains": {"properties": {"type": {"const": "state"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "summary"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "progress"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "metrics"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "list"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "chart"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "text"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "badge"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "alert"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "updated_at"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "actions"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "fields"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "counter"}}}, "minContains": 0, "maxContains": 4},
            {"contains": {"properties": {"type": {"const": "clock"}}}, "minContains": 0, "maxContains": 4},
            {"contains": {"properties": {"type": {"const": "countdown"}}}, "minContains": 0, "maxContains": 4}
          ]
        },
        "style": {
          "type": "object",
          "properties": {
            "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "minLength": 7, "maxLength": 7},
            "density": {"enum": ["comfortable", "compact"], "default": "comfortable"},
            "surface": {"enum": ["card", "plain"], "default": "card"},
            "emphasis": {"enum": ["normal", "strong"], "default": "normal"},
            "icon": {"enum": ["battery", "cup", "clock", "chart", "cloud", "calendar"]}
          },
          "additionalProperties": false
        }
      },
      "required": ["components"],
      "additionalProperties": false
    },
    "events": {
      "description": "订阅宿主事件，声明 event 能力时必填。",
      "const": ["focus.finished"]
    },
    "actions": {
      "description": "待宿主实现。列出可供用户点击或提交的动作名称。",
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": {"type":"string","pattern":"^[a-z][a-z0-9_-]{0,39}$"}
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "type": "object",
      "properties": {
        "source.read": {
          "enum": ["file", "loopback"],
          "description": "Windows 测试版 JS 插件的单一只读来源，由用户在安装后选择文件或授权完整回环 HTTP 地址。"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": {
            "const": "user-selected-read"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "screen.backdrop": {
          "const": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "controls": {"type": "boolean"},
        "spring": {
          "type": "object",
          "properties": {
            "stiffness": {"type": "number", "minimum": 0.2, "maximum": 3},
            "damping": {"type": "number", "minimum": 0.1, "maximum": 1}
          },
          "required": ["stiffness", "damping"],
          "additionalProperties": false
        },
        "shadow": {"type": "number", "minimum": 0, "maximum": 1.5},
        "foreground": {"enum": ["skin", "glass"], "default": "skin"}
      },
      "required": ["controls", "spring"],
      "additionalProperties": false
    },
    "settings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "const": "switch"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "const": "segment"
              },
              "default": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "maxItems": 12,
                "uniqueItems": true,
                "minItems": 2
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default",
              "choices"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "const": "number"
              },
              "default": {
                "type": ["number", "string"]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "maxLength": 4,
                "description": "材质滑块数值后的单位，只用于显示。"
              },
              "precision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3,
                "description": "材质滑块显示的小数位数。未声明时沿用 step 的小数位数。"
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "const": "date"
              },
              "default": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "type": {
                "const": "text"
              },
              "default": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "default"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
      },
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "name",
    "author",
    "version",
    "api",
    "runtime",
    "cover",
    "owner",
    "capabilities",
    "dataVersion",
    "permissions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["network"]},
      "then": {"properties": {"capabilities": {"contains": {"const": "action"}}}}
    },
    {
      "if": {"required": ["statusLayout"]},
      "then": {"properties": {"capabilities": {"contains": {"const": "status.page"}}}}
    },
    {
      "if": {"properties": {"capabilities": {"contains": {"const": "event"}}}},
      "then": {"required": ["events"]},
      "else": {"not": {"required": ["events"]}}
    },
    {
      "if": {"properties": {"capabilities": {"contains": {"enum": ["action", "event", "notice"]}}}},
      "then": {
        "properties": {
          "runtime": {"const": "js"},
          "owner": {"enum": ["tasks", "calendar", "quota", "status"]}
        }
      }
    },
    {
      "if": {"properties": {"capabilities": {"contains": {"const": "action"}}}},
      "then": {"properties": {"capabilities": {"contains": {"const": "status.page"}}}},
      "else": {
        "properties": {
          "statusLayout": {
            "properties": {
              "components": {"not": {"contains": {"properties": {"type": {"enum": ["actions", "fields"]}}}}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"runtime": {"const": "material"}}},
      "then": {
        "required": ["entry", "material", "settings"],
        "properties": {
          "owner": {"const": "appearance"},
          "dataVersion": {"const": 1},
          "entry": {"pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.wgsl$"},
          "capabilities": {
            "items": {"enum": ["appearance.material", "settings"]},
            "contains": {"const": "appearance.material"}
          },
          "permissions": {
            "required": ["screen.backdrop"],
            "maxProperties": 1
          },
          "settings": {
            "items": {
              "properties": {
                "type": {"const": "number"},
                "default": {"type": "string", "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"}
              },
              "required": ["min", "max", "step"]
            }
          }
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]},
        "if": {"properties": {"settings": {"minItems": 1}}},
        "then": {"properties": {"capabilities": {"contains": {"const": "settings"}}}}
      },
      "else": {
        "not": {"required": ["material"]},
        "properties": {
          "capabilities": {"not": {"contains": {"const": "appearance.material"}}},
          "permissions": {"not": {"required": ["screen.backdrop"]}},
          "settings": {
            "items": {
              "if": {"properties": {"type": {"const": "number"}}},
              "then": {
                "properties": {"default": {"type": "number"}},
                "not": {"anyOf": [{"required": ["unit"]}, {"required": ["precision"]}]}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "assets"
          },
          "capabilities": {
            "not": {"contains": {"enum": ["navigation.shortcuts", "wireless.receivers"]}}
          }
        }
      },
      "then": {
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "minItems": 1
          },
          "capabilities": {
            "items": {
              "enum": [
                "appearance.skin",
                "appearance.pet",
                "appearance.icon"
              ]
            }
          },
          "permissions": {
            "maxProperties": 0
          }
        },
        "not": {
          "required": [
            "entry"
          ]
        }
      },
      "else": {
        "required": [
          "entry"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"owner": {"const": "pages"}}},
          {"properties": {"capabilities": {"contains": {"const": "navigation.shortcuts"}}}}
        ]
      },
      "then": {
        "required": ["entry", "settings"],
        "properties": {
          "runtime": {"const": "assets"},
          "owner": {"const": "pages"},
          "entry": {"const": "shortcuts.json"},
          "capabilities": {"const": ["navigation.shortcuts"]},
          "dataVersion": {"const": 1},
          "permissions": {"maxProperties": 0},
          "settings": {"maxItems": 0}
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]}
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"id": {"const": "daozai.wireless-receivers"}}},
          {"properties": {"owner": {"const": "wireless"}}},
          {"properties": {"capabilities": {"contains": {"const": "wireless.receivers"}}}}
        ]
      },
      "then": {
        "required": ["entry", "settings"],
        "properties": {
          "id": {"const": "daozai.wireless-receivers"},
          "runtime": {"const": "assets"},
          "owner": {"const": "wireless"},
          "entry": {"const": "wireless-receivers.json"},
          "capabilities": {"const": ["wireless.receivers"]},
          "dataVersion": {"const": 1},
          "refreshSeconds": {"const": 60},
          "permissions": {"maxProperties": 0},
          "settings": {"maxItems": 0}
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]}
      }
    },
    {
      "if": {"properties": {"capabilities": {"contains": {"const": "status.page"}}}},
      "then": {
        "required": ["entry", "settings"],
        "properties": {
          "runtime": {"const": "js"},
          "owner": {"enum": ["tasks", "calendar", "quota", "status"]},
          "dataVersion": {"const": 1},
          "entry": {"pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.js$"},
          "capabilities": {
            "items": {"enum": ["status.page", "card", "calendar.marker", "quota.source", "settings", "timer", "storage", "action", "event", "notice"]},
            "contains": {"const": "status.page"}
          },
          "permissions": {
            "properties": {"source.read": {"enum": ["file", "loopback"]}},
            "additionalProperties": false
          },
          "settings": {"items": {"properties": {"type": {"enum": ["text", "date"]}}}}
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]},
        "if": {"properties": {"settings": {"minItems": 1}}},
        "then": {"properties": {"capabilities": {"contains": {"const": "settings"}}}}
      }
    },
    {
      "if": {"properties": {"owner": {"const": "status"}}},
      "then": {"properties": {"capabilities": {"contains": {"const": "status.page"}}}}
    },
    {
      "if": {
        "properties": {
          "owner": {
            "const": "self"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "module"
            }
          }
        }
      }
    }
  ]
}
