{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "岛仔 SDK v1 插件清单（评审稿）",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "api": {
      "const": 1,
      "description": "插件要求的接口主版本。高于宿主支持版本时，安装提示需要更新岛仔。"
    },
    "runtime": {
      "enum": [
        "js",
        "wasm",
        "assets",
        "material"
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
    },
    "cover": {
      "const": "cover.png",
      "description": "包根目录的 PNG 封面，最大 256 KiB，宽高不超过 1920×1080，建议 16:9。"
    },
    "owner": {
      "enum": [
        "self",
        "general",
        "appearance",
        "pages",
        "tasks",
        "focus",
        "calendar",
        "music",
        "quota",
        "status",
        "notifications",
        "weather",
        "wireless"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "settings",
          "card",
          "calendar.marker",
          "module",
          "calendar.source",
          "lyrics.source",
          "quota.source",
          "status.page",
          "appearance.skin",
          "appearance.material",
          "navigation.shortcuts",
          "wireless.receivers",
          "storage",
          "timer",
          "event",
          "network",
          "file.read",
          "notification",
          "appearance.pet",
          "appearance.icon"
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "refreshSeconds": {"type":"integer","minimum":60,"maximum":86400,"default":60},
    "statusLayout": {
      "type": "object",
      "description": "状态详情页的组件顺序与样式。缺省时使用默认模板。",
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {"type": {"enum": ["state", "summary", "alert", "updated_at"]}},
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {"const": "progress"},
                  "variant": {"enum": ["ring", "bar"], "default": "ring"}
                },
                "required": ["type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {"const": "metrics"},
                  "columns": {"enum": [1, 2], "default": 2}
                },
                "required": ["type"],
                "additionalProperties": false
              }
            ]
          },
          "allOf": [
            {"contains": {"properties": {"type": {"const": "state"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "summary"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "progress"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "metrics"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "alert"}}}, "minContains": 0, "maxContains": 1},
            {"contains": {"properties": {"type": {"const": "updated_at"}}}, "minContains": 0, "maxContains": 1}
          ]
        },
        "style": {
          "type": "object",
          "properties": {
            "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "minLength": 7, "maxLength": 7},
            "density": {"enum": ["comfortable", "compact"], "default": "comfortable"},
            "surface": {"enum": ["card", "plain"], "default": "card"}
          },
          "additionalProperties": false
        }
      },
      "required": ["components"],
      "additionalProperties": false
    },
    "actions": {
      "description": "待宿主实现。列出可供用户点击或提交的动作名称。",
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": {"type":"string","pattern":"^[a-z][a-z0-9_-]{0,39}$"}
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "type": "object",
      "properties": {
        "source.read": {
          "enum": ["file", "loopback"],
          "description": "Windows 测试版 JS 插件的单一只读来源，由用户在安装后选择文件或授权完整回环 HTTP 地址。"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "focus.finished"
            ]
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": {
            "const": "user-selected-read"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "notifications": {
          "type": "boolean"
        },
        "screen.backdrop": {
          "const": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "controls": {"type": "boolean"},
        "spring": {
          "type": "object",
          "properties": {
            "stiffness": {"type": "number", "minimum": 0.2, "maximum": 3},
            "damping": {"type": "number", "minimum": 0.1, "maximum": 1}
          },
          "required": ["stiffness", "damping"],
          "additionalProperties": false
        },
        "shadow": {"type": "number", "minimum": 0, "maximum": 1.5},
        "foreground": {"enum": ["skin", "glass"], "default": "skin"}
      },
      "required": ["controls", "spring"],
      "additionalProperties": false
    },
    "settings": {
      "type": "array",
      "items": {"$ref": "#/$defs/setting"},
      "maxItems": 32
    },
    "data": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^./\\\\:*?\"<>|][^/\\\\:*?\"<>|]*\\.json$"},
      "description": "实验。包根目录的 UTF-8 JSON 文件，单个最多 64 KiB，合计最多 256 KiB。"
    },
    "timezones": {
      "type": "boolean",
      "description": "实验。为设置中的 IANA 时区名提供当前偏移和夏令时状态。"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$"
      },
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "name",
    "author",
    "version",
    "api",
    "runtime",
    "cover",
    "owner",
    "capabilities",
    "dataVersion",
    "permissions"
  ],
  "additionalProperties": false,
  "$defs": {
    "setting": {
      "type": "object",
      "required": ["key", "label", "type", "default"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "type": {"enum": ["text", "date", "switch", "choice", "number", "time", "weekdays", "list"]},
        "default": {"type": "string"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "maxLength": 4},
        "precision": {"type": "integer", "minimum": 0, "maximum": 3},
        "choices": {
          "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true,
          "items": {
            "type": "object", "required": ["value", "label"], "additionalProperties": false,
            "properties": {
              "value": {"type": "string", "minLength": 1, "maxLength": 80},
              "label": {"type": "string", "minLength": 1, "maxLength": 80}
            }
          }
        },
        "item": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "$ref": "#/$defs/setting",
            "properties": {"type": {"enum": ["text", "choice", "number", "date", "time"]}}
          }
        },
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 8}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "text"}}}, "then": {"properties": {"default": {"minLength": 1, "maxLength": 80}}}},
        {"if": {"properties": {"type": {"const": "date"}}}, "then": {"properties": {"default": {"format": "date"}}}},
        {"if": {"properties": {"type": {"const": "switch"}}}, "then": {"properties": {"default": {"enum": ["true", "false"]}}}},
        {"if": {"properties": {"type": {"const": "time"}}}, "then": {"properties": {"default": {"pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}}}},
        {"if": {"properties": {"type": {"const": "weekdays"}}}, "then": {"properties": {"default": {"pattern": "^(?:[1-7](?:,[1-7]){0,6})?$"}}}},
        {
          "if": {"properties": {"type": {"const": "number"}}},
          "then": {
            "required": ["min", "max", "step"],
            "properties": {"default": {"pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"}}
          },
          "else": {"not": {"anyOf": [{"required": ["min"]}, {"required": ["max"]}, {"required": ["step"]}, {"required": ["unit"]}, {"required": ["precision"]}]}}
        },
        {"if": {"properties": {"type": {"const": "choice"}}}, "then": {"required": ["choices"]}, "else": {"not": {"required": ["choices"]}}},
        {"if": {"properties": {"type": {"const": "list"}}}, "then": {"required": ["item", "maxItems"]}, "else": {"not": {"anyOf": [{"required": ["item"]}, {"required": ["maxItems"]}]}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"anyOf": [{"required": ["data"]}, {"required": ["timezones"]}]},
      "then": {"properties": {"runtime": {"const": "js"}}}
    },
    {
      "if": {"required": ["statusLayout"]},
      "then": {"properties": {"capabilities": {"contains": {"const": "status.page"}}}}
    },
    {
      "if": {"properties": {"runtime": {"const": "material"}}},
      "then": {
        "required": ["entry", "material", "settings"],
        "properties": {
          "owner": {"const": "appearance"},
          "dataVersion": {"const": 1},
          "entry": {"pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.wgsl$"},
          "capabilities": {
            "items": {"enum": ["appearance.material", "settings"]},
            "contains": {"const": "appearance.material"}
          },
          "permissions": {
            "required": ["screen.backdrop"],
            "maxProperties": 1
          },
          "settings": {
            "items": {
              "properties": {
                "type": {"const": "number"},
                "default": {"type": "string", "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"}
              },
              "required": ["min", "max", "step"]
            }
          }
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]},
        "if": {"properties": {"settings": {"minItems": 1}}},
        "then": {"properties": {"capabilities": {"contains": {"const": "settings"}}}}
      },
      "else": {
        "not": {"required": ["material"]},
        "properties": {
          "capabilities": {"not": {"contains": {"const": "appearance.material"}}},
          "permissions": {"not": {"required": ["screen.backdrop"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "assets"
          },
          "capabilities": {
            "not": {"contains": {"enum": ["navigation.shortcuts", "wireless.receivers"]}}
          }
        }
      },
      "then": {
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "minItems": 1
          },
          "capabilities": {
            "items": {
              "enum": [
                "appearance.skin",
                "appearance.pet",
                "appearance.icon"
              ]
            }
          },
          "permissions": {
            "maxProperties": 0
          }
        },
        "not": {
          "required": [
            "entry"
          ]
        }
      },
      "else": {
        "required": [
          "entry"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"owner": {"const": "pages"}}},
          {"properties": {"capabilities": {"contains": {"const": "navigation.shortcuts"}}}}
        ]
      },
      "then": {
        "required": ["entry", "settings"],
        "properties": {
          "runtime": {"const": "assets"},
          "owner": {"const": "pages"},
          "entry": {"const": "shortcuts.json"},
          "capabilities": {"const": ["navigation.shortcuts"]},
          "dataVersion": {"const": 1},
          "permissions": {"maxProperties": 0},
          "settings": {"maxItems": 0}
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]}
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"id": {"const": "daozai.wireless-receivers"}}},
          {"properties": {"owner": {"const": "wireless"}}},
          {"properties": {"capabilities": {"contains": {"const": "wireless.receivers"}}}}
        ]
      },
      "then": {
        "required": ["entry", "settings"],
        "properties": {
          "id": {"const": "daozai.wireless-receivers"},
          "runtime": {"const": "assets"},
          "owner": {"const": "wireless"},
          "entry": {"const": "wireless-receivers.json"},
          "capabilities": {"const": ["wireless.receivers"]},
          "dataVersion": {"const": 1},
          "refreshSeconds": {"const": 60},
          "permissions": {"maxProperties": 0},
          "settings": {"maxItems": 0}
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]}
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"owner": {"const": "status"}}},
          {"properties": {"capabilities": {"contains": {"const": "status.page"}}}}
        ]
      },
      "then": {
        "required": ["entry", "settings"],
        "properties": {
          "runtime": {"const": "js"},
          "owner": {"const": "status"},
          "dataVersion": {"const": 1},
          "entry": {"pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.js$"},
          "capabilities": {
            "items": {"enum": ["status.page", "settings", "timer", "storage"]},
            "contains": {"const": "status.page"}
          },
          "permissions": {
            "properties": {"source.read": {"enum": ["file", "loopback"]}},
            "additionalProperties": false
          }
        },
        "not": {"anyOf": [{"required": ["assets"]}, {"required": ["actions"]}]},
        "if": {"properties": {"settings": {"minItems": 1}}},
        "then": {"properties": {"capabilities": {"contains": {"const": "settings"}}}}
      }
    },
    {
      "if": {
        "properties": {
          "owner": {
            "const": "self"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "module"
            }
          }
        }
      }
    }
  ]
}
